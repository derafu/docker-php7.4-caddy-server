#
# Environment variables for local development.
#
# The variables are used in the `docker-compose.yml` file to configure the
# docker container.
#
# Copy this file to `.env` and modify the variables as needed.
#

# Caddy configuration.
CADDY_DEBUG=debug
CADDY_EMAIL=admin@example.com

# PHP configuration.
# These are independent of CADDY_DEBUG: setting CADDY_DEBUG no longer
# changes OPcache or Xdebug on its own.
OPCACHE_ENABLE=1
XDEBUG_ENABLE=0
NETWORK_TOOLS_ENABLE=0
# Comma-separated, no spaces. Empty by default: sowerphp-framework's
# Controller::shell() (background task launching) needs exec() from a web
# request, so most sites built on it cannot use the hardened value below.
# Only set this if you've confirmed the site doesn't need any of them.
# Recommended hardened value, if/when it's safe to use:
# PHP_DISABLE_FUNCTIONS=exec,shell_exec,system,passthru,proc_open,popen
PHP_DISABLE_FUNCTIONS=

# Port mapping for local development.
HTTP_PORT=8080
HTTPS_PORT=8443
SSH_PORT=2222
MANAGER_PORT=9090
